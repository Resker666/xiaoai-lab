# For the external XiaoAiAgent bridge (never commit real credentials).
# Reference only: neither this CLI nor the inspected upstream loader reads this
# file automatically. Set process environment variables; see experiment 003.
MI_USER=
MI_PASS=
# Target deviceID from upstream --list-devices; keep the real value private.
MI_DID=
# Optional API key for cloud LLMs. Local Ollama does not need one.
DEEPSEEK_API_KEY=
